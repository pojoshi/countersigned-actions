# Used by `countersigned` (CLI) and the API container.
DATABASE_URL=postgresql://countersigned:countersigned@localhost:5432/countersigned
# 1 = create demo agents/approvers/data with well-known keys (local use only). 0 = bring your own principals.
SEED_DEMO=1
# inline = the API process also runs the executor loop. off = run `countersigned worker` yourself.
WORKER=inline
